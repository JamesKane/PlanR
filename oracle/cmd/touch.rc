# touch: creating, -c, and its usage. (Whether touch changes an existing
# file's time depends on the file system: Plan 9's ramfs, where Plan R
# runs these, keeps its times as the writes left them.)
touch a
ls a
touch -c b >[2]/dev/null || echo nocreate failed
ls b >[2]/dev/null || echo no b
touch -t 1000 old
ls old
touch -t 0x100 hex
ls hex
touch || echo usage failed
touch -t || echo usage failed
