# seq: counting up and down, fractions, -w and -f.
seq 3
seq 2 5
seq 1 2 10
seq 5 -1 1
seq 3 1
seq 0 0.1 0.5
seq -w 8 11
seq -w 0.5 0.25 1.5
seq -w -2 2
seq 999998 1000001
seq -w 999999 1000000
seq -f 'n=%g' 3
seq -f '%5.2f' 1 3
seq -f'%e' 2 2
seq -f '%05.1f|' -1 1
seq -f '%%%g%%' 1
seq 1 0 3 || echo zero failed
seq || echo usage failed
seq 1 2 3 4 || echo usage failed
