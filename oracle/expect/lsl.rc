# ls -l, -m, -s and -t, mkdir -m, and the name stat gives ., with Plan R's
# ramfs (whose times are a file's writes: they are left out).
fn l { x=`{ls -l $*}; echo $x(1-6) $x(10-) }
touch a
echo hello >b
mkdir d
l a
l b
x=`{ls -ld d}
echo $x(1-6) $x(10)
sleep 1
echo newer >a
ls -t a b
ls -m a
ls -s b
date 0
date 951868799
cd d
ls -d . ..
cd ..
mkdir -m 750 m
x=`{ls -ld m}
echo $x(1-6) $x(10)
