# ls -l, -m and -q, and du -t, with times set and Plan R's ramfs.
touch -t 0 a
echo hello >b
touch -t 951868799 b
mkdir d
touch -t 1000000 d
ls -l a b d
ls -ld d
ls -lt a b
ls -m a
ls -s b
du -t a
du -tu a >/dev/null && echo atime ok
date 0
date 951868799
cd d
ls -d . ..
cd ..
mkdir -m 750 m
touch -t 0 m
ls -ld m
