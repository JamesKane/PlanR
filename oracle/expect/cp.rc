# cp: to a name, into a directory, -x, and each error.
echo hello >a
cp a b
cat b
mkdir d
cp a b d
ls d
cp a d/c
cat d/c
seq 1 3000 >big
cp big big2
cmp big big2 && echo big same
echo again >b
cp a b
cat b
chmod 751 a
cp a x
x=`{ls -l x}
echo $x(1-6) $x(10)
chmod 640 a
cp -x a y
y=`{ls -l y}
echo $y(1-6) $y(10)
cp a a || echo same failed
cp a ./a || echo same failed
cp d e || echo directory failed
cp a b nonesuch || echo usage failed
cp nonesuch x || echo stat failed
cp a nonesuch/x || echo create failed
cp a || echo usage failed
cp -z a b || echo usage failed
