# Each command's errors, with Plan 9's error strings.
ls nonesuch
mkdir nonesuch/x
rm nonesuch
rm -r nonesuch
mkdir full
touch full/f
rm full
touch nonesuch/x
touch -c nonesuch
wc nonesuch
cmp nonesuch nonesuch
strings nonesuch
du nonesuch
tail nonesuch
tee nonesuch/x </dev/null
cp nonesuch x
chmod 644 nonesuch
mv nonesuch x
cat nonesuch
# Walks: one that stops partway, one through a file, and .. from a file,
# which Plan 9 walks rather than taking away from the name.
ls full/nonesuch/x
ls full/f/x
ls /dev/cons/../null
touch x/
ls '#Z'
/tmp
cd /tmp
echo end
